{
  "name": "@endless-story/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./services/character-agent/beat-prompt": "./src/services/character-agent/beat-prompt.ts",
    "./services/character-agent/interview-prompt": "./src/services/character-agent/interview-prompt.ts",
    "./services/event-dossier/compile": "./src/services/event-dossier/compile.ts",
    "./services/storyteller-chapter/anthology": "./src/services/storyteller-chapter/anthology.ts",
    "./services/*": "./src/services/*/index.ts",
    "./types": "./src/types/index.ts",
    "./infra/json-loose": "./src/infra/json-loose.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "eval:aid": "tsx --env-file-if-exists=../web/.env.local src/services/character-agent/__eval__/aid-eval.ts",
    "harness:chapter": "tsx --env-file-if-exists=../web/.env.local src/services/storyteller-chapter/__harness__/replay.ts"
  },
  "dependencies": {
    "@endless-story/llm": "workspace:*",
    "@endless-story/memwal": "workspace:*",
    "@endless-story/sdk": "workspace:*",
    "@endless-story/shared": "workspace:*",
    "@endless-story/troupe": "workspace:*",
    "@mysten/sui": "^2.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
