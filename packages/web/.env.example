# Endless Story · web env vars
# Copy to .env.local (gitignored) and fill in. All server-side — nothing reaches the client.

# ── LLM text · preview / portrait curation / moderation ──
# Z.AI direct (preferred when AI_PROVIDER=auto): https://docs.z.ai
# ZAI_MODEL_PRIMARY=glm-5.1              # creative (default)
# ZAI_MODEL_CHEAP=GLM-4.7-FlashX        # decisions / moderation (default)
# Poe fallback — https://poe.com/api_key
# POE_MODEL_PRIMARY=GLM-5.1-FW           # creative (default)
# POE_MODEL_CHEAP=GLM-4.7-N             # decisions / moderation (default)
ZAI_API_KEY=
POE_API_KEY=
# ANTHROPIC_API_KEY=                    # direct Anthropic (optional third provider)
AI_PROVIDER=auto                      # auto | zai | poe | anthropic

# ── LLM image · portrait generation ──
# gpt-image-2 @ 1024x1536 — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-2

# ── Storyteller co-sign ──
# Admin keypair (World AdminCap + Saga StorytellerCap + Faucet AdminCap), same
# identity as cli deploy. Export: sui keytool export --key-identity <alias>
SUI_ADMIN_PRIVATE_KEY=suiprivkey1...

# ── MemWal · SEAL-encrypted character memory (testnet only) ──
# Creds from the dashboard: testnet https://staging.memwal.ai · mainnet https://memwal.ai
# Unset = narrative still runs, just without long-term memory.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=0x...
MEMWAL_SERVER_URL=https://memwal-relayer.zeabur.app  # auto-picked per network; point at your self-hosted relayer
MEMWAL_RECALL_CONCURRENCY=2                          # default 1; raise only after self-hosting SEAL + Walrus
MEMWAL_RELAYER_THREE_FACTOR=1                        # set ONCE your self-hosted relayer is live: it ranks the full
#                                                       # namespace (importance×recency×relevance) → client drops the
#                                                       # over-fetch ×3 + re-rank (≈3× fewer SEAL decrypts per recall)

# ── Moderation HMAC ──
# Signs moderated prompts. Generate: openssl rand -hex 32
RECRUITMENT_MOD_SECRET=

# ── Network ──
SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_NETWORK=testnet

# ── Kiosk──
# Admin once to create Kiosk（可用 chamber::create_personal_vault 或 sui client），
# 把 shared Kiosk id + KioskOwnerCap id 填進來。Redeploy 後還需 stillTransferPolicyId。
# SHOP_KIOSK_ID=0x...
# SHOP_KIOSK_CAP_ID=0x...

# ── Assets ──
NEXT_PUBLIC_WALRUS_AGGREGATOR=https://walrus.231labs.xyz
DEMO_CLIPS_URL=https://assets.zeabur.app/api/manifest/hero-clips
ASSET_SERVICE_URL=https://assets.zeabur.app
ASSET_SERVICE_SECRET=

# ── Autonomous world loop · cli world-loop → POST /api/tick ──
# TICK_LOOP_SECRET=                     # require Bearer auth — set before exposing the app
# WORLD_LOOP_URL=http://localhost:3000

# ── Dev only · never in prod ──
# MODERATION_ALLOW_UNCONFIGURED=1       # let moderate-prompt pass without an LLM key