# Endless Story · web env vars
# Copy to .env.local (gitignored) and fill in. Server-side unless prefixed NEXT_PUBLIC_
# (those are inlined into the browser bundle at build → set BEFORE build; rebuild after changes).
#
# TIER 1 — interactive site only: Network + Assets sections suffice (home, browse, chain reads, admin assets).
# TIER 2 — mint, character memory, autonomy: also add ZAI / OpenAI / SUI_ADMIN / MemWal / world-loop.
# Filled values are from the current deployment; only blanks need your input.

# ── LLM text · preview / portrait curation / moderation / autonomy ──
# Z.AI direct API (OpenAI-compatible) — https://docs.z.ai → get a key at https://z.ai/manage-apikey
# Models: primary = GLM-5.1 (creative writing), cheap = GLM-4.7-FlashX paid tier (decisions / moderation).
ZAI_API_KEY=
# ZAI_MODEL_PRIMARY=glm-5.1             # creative writing (storyteller / chapters / persona)
# ZAI_MODEL_CHEAP=GLM-4.7-FlashX        # decisions / moderation / inner monologue
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_PROVIDER picks the text provider; 'auto' prefers Z.AI, then Poe, then Anthropic.
# AI_PROVIDER=auto                      # auto | zai | poe | anthropic
#
# Alternatives (only needed if not using Z.AI):
# POE_API_KEY=                          # one Poe key covers Claude / Gemini / GLM / GPT — https://poe.com/api_key
# ANTHROPIC_API_KEY=                    # direct Anthropic Claude

# ── LLM image · portrait generation ──
# gpt-image-2 @ 1024x1536 — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# ── Storyteller co-sign ──
# Admin keypair (World AdminCap + Saga StorytellerCap + Faucet AdminCap), same
# identity as cli deploy. Export: sui keytool export --key-identity <alias>
SUI_ADMIN_PRIVATE_KEY=

# ── MemWal · SEAL-encrypted character memory (testnet only) [TIER 2] ──
# Memory requires all four to be set; missing any → narrative still runs, just no long-term memory (graceful no-op):
#   ① MEMWAL_PRIVATE_KEY   ② MEMWAL_ACCOUNT_ID   ③ SUI_ADMIN_PRIVATE_KEY (above; shared for SEAL)
#   ④ OPENAI_API_KEY (above; shared for embeddings)
# Self-hosted relayer (memwal-relayer.zeabur.app) does not verify delegate signatures → ①② can be any value
# (any ed25519 key / any id); only managed relayer (staging/relayer.memwal.ai) needs real dashboard credentials.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://memwal-relayer.zeabur.app
# Self-hosted three-factor relayer is live — enable this: ranks the whole namespace, ~3× fewer SEAL decrypts on recall.
MEMWAL_RELAYER_THREE_FACTOR=1
# MEMWAL_RECALL_CONCURRENCY=2          # default 1; raise after self-hosted SEAL + Walrus is stable

# ── Moderation HMAC ──
# Signs moderated prompts. Generate: openssl rand -hex 32
RECRUITMENT_MOD_SECRET=

# ── Network [TIER 1] ──
SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_NETWORK=testnet

# ── Assets [TIER 1] ──
# NEXT_PUBLIC_WALRUS_AGGREGATOR : all Walrus reads (portraits, chapters, clips) via your CDN aggregator.
# DEMO_CLIPS_URL                : homepage hero video manifest (from asset service).
# ASSET_SERVICE_URL/SECRET      : API for admin Assets panel; SECRET = asset service RELAYER_SECRET value.
NEXT_PUBLIC_WALRUS_AGGREGATOR=https://walrus.231labs.xyz
DEMO_CLIPS_URL=https://assets.zeabur.app/api/manifest/hero-clips
ASSET_SERVICE_URL=https://assets.zeabur.app
ASSET_SERVICE_SECRET=

# ── Autonomous world loop · cli world-loop → POST /api/tick ──
# TICK_LOOP_SECRET=                     # require Bearer auth — set before exposing the app
# WORLD_LOOP_URL=http://localhost:3000

# ── Tick feature flags (EXPERIMENTAL) · deploy-wide defaults for an AUTO-running
#    runner that can't pass CLI/POST flags. Resolution: POST body > env > off.
#    Set =1 to turn on. See docs/EVENT_LIFECYCLE.md. Recommended full set:
# TICK_EVENT_SPINE=1                     # 跨 tick 事件 spine（開→續→收回結算）
# TICK_PARALLEL_EVENTS=1                 # 並行事件（一軸一事件）
# TICK_ATTENTION_BUDGET=1                # 注意力耦合（並行事件互相拉扯）
# TICK_RIVAL_GRAVITY=1                   # 相吸移動（讓對手聚到擂台，事件才成形）
# TICK_LLM_FRAMING=1                     # LLM 框題（活句，失敗自動退回決定性句）
# TICK_DIRECTOR_RESOURCES=1              # LLM 立題（驗證 + 限流）
# TICK_MAX_CONCURRENT_EVENTS=2           # 並行事件上限（預設 2）

# ── Dev only · never in prod ──
# MODERATION_ALLOW_UNCONFIGURED=1       # let moderate-prompt pass without an LLM key
