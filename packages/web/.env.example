# ─────────────────────────────────────────────────────────────────
# Endless Story · web env vars
#
# Copy to `.env.local` (gitignored) and fill in.
# Server-side only — none of these are exposed to the client.
# ─────────────────────────────────────────────────────────────────

# ── LLM text (character preview + portrait curation + moderation) ──
# Get one from https://poe.com/api_key — covers Claude / Gemini / GLM / GPT
# in a single key. The wizard's primary creative model defaults to
# Claude-Sonnet-4.6; cheap model defaults to Claude-Haiku-4.5.
POE_API_KEY=

# Optional overrides — see packages/llm/src/text/models.ts for the picks.
# POE_MODEL_PRIMARY=Claude-Sonnet-4.6
# POE_MODEL_CHEAP=Claude-Haiku-4.5

# Optional alternative to Poe — direct Anthropic. Either POE_API_KEY OR
# ANTHROPIC_API_KEY must be set; if both are present, Poe is preferred.
# Override with AI_PROVIDER=anthropic to flip.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=auto   # auto | poe | anthropic


# ── LLM image (portrait generation) ──
# Get one from https://platform.openai.com/api-keys
# Uses gpt-image-2 at 1024x1536 (4:5 portrait), quality=medium.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2


# ── Storyteller co-sign (server action auto-redeem) ──
# The admin keypair that holds the World AdminCap + Saga StorytellerCap
# + Faucet AdminCap (all written during cli bootstrap).
#
# Format: bech32 suiprivkey1... — export with:
#   sui keytool export --key-identity <alias>
#
# This is the SAME identity that runs cli deploy / bootstrap. The cli
# scripts read from ~/.endless-wuxia/keypair.json; this env var lets
# web's server actions sign without file IO (Vercel-friendly).
SUI_ADMIN_PRIVATE_KEY=


# ── Moderation HMAC ──
# Signs approved prompts so downstream actions (preview / portrait) can
# verify the user description was actually moderated.
#
# Generate: openssl rand -hex 32
# Defaults to 'dev-moderation-secret-replace-me' if unset.
RECRUITMENT_MOD_SECRET=


# ── Network override ──
# Auto-resolved from contract-ids.ts after deploy. Set this only if you
# want to point the web app at a different network before deploying
# (e.g. browse mainnet content while developing).
# NEXT_PUBLIC_SUI_NETWORK=devnet


# ── Dev escape hatch ──
# If you want to test the wizard's UX without configuring an LLM key,
# this lets moderate-prompt pass without calling out. NEVER set in prod.
# MODERATION_ALLOW_UNCONFIGURED=1
