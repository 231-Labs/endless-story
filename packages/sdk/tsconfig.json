{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The characterization tests run standalone under `node --test` and import
    // the source with explicit `.ts` extensions; allowImportingTsExtensions
    // lets tsc accept them (valid because the base sets noEmit).
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "test/**/*"]
}
