{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Standalone harness run via plain `node` (native TS type-stripping, Node ≥ 22.18
    // / 23.6) and type-checked by tsc with noEmit. Relative imports carry explicit
    // `.ts` extensions so node/tsx resolve them directly; allowImportingTsExtensions
    // lets tsc accept them. Mirrors packages/economy + packages/troupe + packages/drama.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "driver/**/*", "fixtures/**/*", "test/**/*"]
}
