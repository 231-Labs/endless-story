{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Standalone under `node --test` (native TS type-stripping), which requires explicit
    // `.ts` extensions on relative imports. allowImportingTsExtensions lets tsc accept them;
    // valid because the base sets noEmit (tsc only type-checks). Mirrors packages/drama.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "driver/**/*", "scenarios/**/*", "test/**/*"]
}
