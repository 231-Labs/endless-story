{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Standalone engine run via `tsx` (and type-checked by tsc with noEmit).
    // Relative imports carry explicit `.ts` extensions so tsx/node resolve them
    // directly; allowImportingTsExtensions lets tsc accept them. Mirrors
    // packages/troupe + packages/economy + packages/drama.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "test/**/*"]
}
