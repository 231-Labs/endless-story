    "scenes": [
      {
        "sceneId": "s1",
        "title": "遊湖借傘",
        "parts": [
          "bai",
          "xu"
        ],
        "mood": "joy",
        "beats": [
          {
            "beat": 1,
            "summary": "西湖初遇，許仙白娘子借傘定情。",
            "tension": 0.3,
            "mood": "joy"
          }
        ],
        "lines": [
          {
            "type": "stage",
            "text": "【西湖雨意，煙水迷離。許仙撐傘，見白素貞衣衫微濕，神色驚惶，不禁將傘斜過去。】"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "念",
            "text": "娘子慢走，這西湖雨勢又急又密，若不棄嫌，且在小生這傘下避一避。"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "念",
            "text": "多謝官人美意。只是雨驟風狂，若是淋壞了這把傷春悲秋的骨子，怕是難以再見青天。"
          },
          {
            "type": "stage",
            "text": "【白素貞素手輕扶傘柄，指尖似無意觸及許仙手背，許仙一顫，卻是沒有退縮。】"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "唱",
            "text": "非是貪戀眼前春，只為伊人雨裡身。這傘兒借你遮風雨，莫教濕透翠羅裙。"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "唱",
            "text": "天條冷律鎖雲津，誰解凡塵一縷真。今朝借得傘中意，不為成仙只為人。"
          },
          {
            "type": "stage",
            "text": "【二人相視，雨聲漸歇，唯餘心跳如鼓。白素貞接過油紙傘，目光纏綣。】"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "念",
            "text": "官人，這傘我借去了。明日若還雨，我在斷橋等你；若天晴，我也在橋頭等你。"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "念",
            "text": "好，好！無論晴雨，許仙必來。這傘便是憑證，斷橋便是歸處。"
          }
        ]
      },
      {
        "sceneId": "s2",
        "title": "驚變",
        "parts": [
          "bai",
          "xu"
        ],
        "mood": "tense",
        "beats": [
          {
            "beat": 1,
            "summary": "端午雄黃，白娘子現形，許仙驚仆。",
            "tension": 0.9,
            "mood": "tense"
          }
        ],
        "lines": [
          {
            "type": "stage",
            "text": "【雄黃酒氣上湧，白素貞面露難色，強自鎮壓，身形微晃】"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "念",
            "text": "官人，這酒氣太烈，妾身……妾身有些不適，且去歇息片刻。"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "念",
            "text": "娘子臉色煞白，莫非是中了暑氣？待為夫扶你回帳安歇。"
          },
          {
            "type": "stage",
            "text": "【許仙伸手欲扶，觸及素貞手，驚覺冰冷刺骨；素貞痛呼一聲，頭上隱現蛇形冠角】"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "念",
            "text": "啊！這……這是何物？娘子你……你究竟是人是妖？！"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "唱",
            "text": "【西皮散板】非是妖魔降凡塵，只為官人一片真。天條縱有千斤重，難斷我夫妻一點恩。"
          },
          {
            "type": "stage",
            "text": "【狂風驟起，帳幔翻飛，白素貞現出原形半身，淚眼婆娑望向許仙】"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "念",
            "text": "妖……妖怪！救命！救命啊！"
          },
          {
            "type": "stage",
            "text": "【許仙雙目翻白，驚恐過度，仰面仆倒在地，昏死過去】"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "唱",
            "text": "【哭頭】眼睜睜，官人嚇斷魂，千年的道行拋雲端。不為了成仙登極樂，只為了凡塵裡這一點點捨不得！"
          },
          {
            "type": "stage",
            "text": "【白素貞撲倒在許仙身上，恢復人形，痛哭失聲】"
          }
        ]
      },
      {
        "sceneId": "s3",
        "title": "斷橋",
        "parts": [
          "bai",
          "xu",
          "qing"
        ],
        "mood": "sorrow",
        "beats": [
          {
            "beat": 1,
            "summary": "水漫金山後重逢斷橋，恨與不捨交織。",
            "tension": 0.8,
            "mood": "sorrow"
          }
        ],
        "lines": [
          {
            "type": "stage",
            "text": "【西風緊，殘荷敗葉。白素貞扶腹踉蹌上，小青怒氣沖沖扶之。許仙遠遠望見，戰戰兢兢趨前。】"
          },
          {
            "type": "line",
            "who": "小青",
            "mode": "念",
            "text": "好你個負心漢！金山一戰，姐姐幾乎喪命，你還有臉來見我們？"
          },
          {
            "type": "stage",
            "text": "【小青拔劍欲刺，白素貞攔住，身形一晃，掩面而泣。許仙雙膝跪地。】"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "唱",
            "text": "看斷橋，橋未斷，卻斷了柔腸。恨郎君，聽讒言，險些兒送我入黃粱。"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "念",
            "text": "娘子！我悔之晚矣！法海以此惑我，如今方知娘子情深意重，我萬死難贖其罪。"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "唱",
            "text": "非是怨天條律法森嚴，也非恨法海無端拆散。只恨你，心裡無我，任由風雨摧殘。"
          },
          {
            "type": "stage",
            "text": "【白素貞俯身扶起許仙，指尖輕顫，整理其凌亂衣襟，眼中淚光閃爍。】"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "念",
            "text": "起來吧。若真個恨極，早在金山便絕了情分，何苦帶著身孕，受盡風波來此尋你？"
          },
          {
            "type": "line",
            "who": "許仙",
            "mode": "唱",
            "text": "娘子恩德，許仙銘感五內，此生此世，再不相負！"
          },
          {
            "type": "line",
            "who": "白素貞",
            "mode": "念",
            "text": "休說此生。只要凡塵裡這一點點捨不得還在，便是天兵天將將我鎮在雷峰塔下，我也甘願。"
          },
          {
            "type": "stage",
            "text": "【三人相對，白素貞輕嘆一聲，緊握許仙手，緩緩向橋下走去。】"
          }
        ]
      }
    ],
    "authorId": "banzhu",
    "authorName": "沈雪笙"
  },
