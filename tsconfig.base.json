{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // The repo runs TypeScript source directly (every package's `main` is
    // `./src/index.ts`; no build step except `next build`), so importing a
    // package whose internal imports use `.ts` extensions (needed for
    // `node --test`) is legitimate. Valid here because every tsconfig is noEmit.
    "allowImportingTsExtensions": true,
    "incremental": true
  }
}
