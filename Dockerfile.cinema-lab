# Endless Story · lab (片場 Cinema Lab) — slim standalone image.
#
# 專給 lab 服務用的瘦身版：Next `output: 'standalone'` 只帶 server 真正用到的
# 檔案，映像自 ~1GB 縮到 ~200MB，拉取／部署快一個檔次。
#
# 與根目錄 Dockerfile（正式站 web 用）的差異：
#   - 不編 Move bytecode（lab 完全鏈下，管理台「升級合約」不在此服務使用）
#   - runtime 不帶 workspace node_modules 與 pnpm（lab 不 spawn cli scripts）
#   - 內建劇本以同路徑補進映像（engine 於 build 時把 /repo 絕對路徑 inline 進
#     bundle，故 builder 與 runtime 都必須以 /repo 為根，佈局才對得上）
#
# Zeabur 掛法：檔名尾巴＝服務名（Dockerfile.[服務名] 慣例，同
# Dockerfile.event-poller）。lab 服務現名 cinema-lab，故此檔名。
# root 留在 repo 根。環境變數照舊：LAB_SECRET、
# LAB_DATA_DIR=/data/cinema-lab（volume）、POE_API_KEY 等 runtime 注入。

# ──────────────────────────────────────────────────────────────────────────
# Stage 1 — builder：整個 workspace 安裝 + standalone build
# ──────────────────────────────────────────────────────────────────────────
FROM node:23-slim AS builder
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile

# NEXT_PUBLIC_* 是 build 時 inline（公開、非機密）；機密 env 全是 runtime 注入。
ARG NEXT_PUBLIC_SUI_NETWORK=testnet
ARG NEXT_PUBLIC_WALRUS_AGGREGATOR=https://walrus.231labs.xyz
ENV NEXT_PUBLIC_SUI_NETWORK=$NEXT_PUBLIC_SUI_NETWORK \
    NEXT_PUBLIC_WALRUS_AGGREGATOR=$NEXT_PUBLIC_WALRUS_AGGREGATOR \
    NEXT_STANDALONE=1

RUN pnpm --filter @endless-story/web build

# ──────────────────────────────────────────────────────────────────────────
# Stage 2 — runtime：只有 standalone server + static + public + 內建劇本
# ──────────────────────────────────────────────────────────────────────────
FROM node:23-slim
WORKDIR /repo
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0

# standalone 樹以 repo 佈局為鏡（outputFileTracingRoot=/repo）：
# /repo/node_modules（追蹤出的最小集）+ /repo/packages/web/server.js + .next/server
COPY --from=builder /repo/packages/web/.next/standalone/ ./
COPY --from=builder /repo/packages/web/.next/static ./packages/web/.next/static
COPY --from=builder /repo/packages/web/public ./packages/web/public

# 內建劇本館（seed／季框／牌組 JSON）：engine 在 runtime 以 fs.readdirSync 讀取，
# 路徑由 workspace-paths.ts 在 build 時 inline 成 /repo/packages/cli/scripts/<dir>。
# Next 的 output tracing 只追「被 import 的模組」，fs 讀的資料目錄它看不到，所以每一個
# 內建館都必須在這裡顯性補進同一位置。
#
# **加了新的內建館就要加一行。** 漏掉不會有任何錯誤：`listJsonIds` 讀不到目錄就回空
# 陣列，於是下拉選單靜靜地少一整類選項——季框與牌組就是這樣漏了整整一輪（映像只帶了
# stories，而註解還寫著「builtin seasons 目前無此目錄」，那句話在 seasons/ 建起來的那天
# 就過時了）。改 workspace-paths.ts 的 default*Dir() 時，回來看這一段。
#
# 自撰的劇本／季框／牌組在 $LAB_DATA_DIR volume 上，與映像無關。
COPY --from=builder /repo/packages/cli/scripts/stories ./packages/cli/scripts/stories
COPY --from=builder /repo/packages/cli/scripts/seasons ./packages/cli/scripts/seasons
COPY --from=builder /repo/packages/cli/scripts/decks   ./packages/cli/scripts/decks

VOLUME ["/data"]
EXPOSE 3000
# standalone server 讀 PORT／HOSTNAME（Zeabur 注入 PORT）。
CMD ["node", "packages/web/server.js"]
