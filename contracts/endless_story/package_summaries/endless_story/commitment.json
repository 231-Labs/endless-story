  "structs": {
    "Commitment": {
      "index": 0,
      "doc": " A single committed reference. Shared so any reader (web, indexer,\n future verifier) can fetch by object id without owner gating. Object\n itself is immutable after creation — no setters exposed.",
      "attributes": [],
      "abilities": [
        "Key"
      ],
      "type_parameters": [],
