                  "address": "sui",
                  "name": "object"
                },
                "name": "UID",
                "type_arguments": []
              }
            }
          },
          "saga_id": {
            "index": 1,
            "doc": " Saga this commitment belongs to. Lets readers filter by world arc.",
            "type_": {
              "Datatype": {
                "module": {
                  "address": "sui",
                  "name": "object"
                },
                "name": "ID",
                "type_arguments": []
              }
            }
          },
          "subject_id": {
            "index": 2,
            "doc": " Free-form subject — typically `character_id`, but the module does\n not enforce a type so future surfaces (scene-level commits, saga-\n level commits) can reuse the struct.",
            "type_": {
              "Datatype": {
                "module": {
                  "address": "sui",
                  "name": "object"
                },
                "name": "ID",
                "type_arguments": []
              }
            }
          },
          "content_hash": {
            "index": 3,
            "doc": " Hash of the committed content. Caller's responsibility to pick a\n hash function and pre-hash off-chain; module treats it as opaque\n bytes so we don't lock in an algorithm.",
            "type_": {
              "vector": "u8"
            }
          },
          "blob_id": {
            "index": 4,
            "doc": " Walrus blob id (or any other off-chain storage reference). Opaque\n bytes; readers know how to resolve based on application context.",
            "type_": {
              "vector": "u8"
            }
          },
          "committer": {
            "index": 5,
            "doc": " Address that signed the commit (= the StorytellerCap holder at\n time of commit). Useful for audit even though the cap itself can\n be transferred later.",
            "type_": "address"
          },
          "committed_at_ms": {
